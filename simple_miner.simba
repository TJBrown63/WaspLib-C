{$DEFINE SCRIPT_ID := 'simple-miner'}
{$DEFINE SCRIPT_REVISION := '1'}
{$I SRL-T/osr.simba}
{$I WaspLib/osr.simba}

(*
 * Simple Configurable Mining Script
 *
 * Configure which ore to mine below and the script will mine until inventory is full.
 * Supports: Clay, Copper, Tin, Iron, Silver, Coal, Gold, Mithril, Adamantite, Runite,
 *           Amethyst, Gem rocks, Sandstone, Granite
 *)

type
  EOreType = (
    ORE_CLAY,
    ORE_COPPER,
    ORE_TIN,
    ORE_IRON,
    ORE_SILVER,
    ORE_COAL,
    ORE_GOLD,
    ORE_MITHRIL,
    ORE_ADAMANTITE,
    ORE_RUNITE,
    ORE_AMETHYST,
    ORE_GEM,
    ORE_SANDSTONE,
    ORE_GRANITE
  );

const
  // ===== CONFIGURE YOUR MINING HERE =====
  ORE_TO_MINE: EOreType = ORE_IRON;  // Change this to the ore you want to mine

  POWER_MINING: Boolean = False;     // True = drop ores and keep mining, False = stop when full
  // ========================================

type
  EState = (
    CLICK_ROCK,
    WAIT_MINING,
    DROP_ORES,
    INVENTORY_FULL,
    END_SCRIPT
  );

  TSimpleMiner = record(TBaseScript)
    State: EState;
    RockColor: TCTS2Color;
    RockUpText: String;
    IsMining: Boolean;
  end;

procedure TSimpleMiner.Init(maxActions: UInt32; maxTime: UInt64); override;
begin
  inherited;

  // Set rock color and uptext based on ore type
  // Colors are taken from the library's rock definitions
  case ORE_TO_MINE of
    ORE_CLAY:
    begin
      Self.RockColor := CTS2(7506796, 15, 0.13, 0.42);
      Self.RockUpText := 'Clay';
    end;
    ORE_COPPER:
    begin
      Self.RockColor := CTS2(4878743, 10, 0.06, 0.38);
      Self.RockUpText := 'Copper';
    end;
    ORE_TIN:
    begin
      Self.RockColor := CTS2(5131143, 7, 0.03, 0.23);
      Self.RockUpText := 'Tin';
    end;
    ORE_IRON:
    begin
      Self.RockColor := CTS2(2240329, 11, 0.12, 0.60);
      Self.RockUpText := 'Iron';
    end;
    ORE_SILVER:
    begin
      Self.RockColor := CTS2(6975567, 13, 0.06, 0.21);
      Self.RockUpText := 'Silver';
    end;
    ORE_COAL:
    begin
      Self.RockColor := CTS2(2568501, 7, 0.05, 0.28);
      Self.RockUpText := 'Coal';
    end;
    ORE_GOLD:
    begin
      Self.RockColor := CTS2(4552849, 8, 0.34, 1.02);
      Self.RockUpText := 'Gold';
    end;
    ORE_MITHRIL:
    begin
      Self.RockColor := CTS2(4151374, 10, 0.04, 0.29);
      Self.RockUpText := 'Mithril';
    end;
    ORE_ADAMANTITE:
    begin
      Self.RockColor := CTS2(5328219, 10, 0.07, 0.13);
      Self.RockUpText := 'Adamantite';
    end;
    ORE_RUNITE:
    begin
      Self.RockColor := CTS2(4022103, 12, 0.07, 0.20);
      Self.RockUpText := 'Runite';
    end;
    ORE_AMETHYST:
    begin
      Self.RockColor := CTS2(5516609, 22, 0.20, 0.08);
      Self.RockUpText := 'Amethyst';
    end;
    ORE_GEM:
    begin
      Self.RockColor := CTS2(4419685, 16, 0.05, 0.38);
      Self.RockUpText := 'Gem';
    end;
    ORE_SANDSTONE:
    begin
      Self.RockColor := CTS2(7442272, 11, 0.08, 0.15);
      Self.RockUpText := 'Sandstone';
    end;
    ORE_GRANITE:
    begin
      Self.RockColor := CTS2(6585449, 8, 0.09, 0.46);
      Self.RockUpText := 'Granite';
    end;
  end;

  Self.IsMining := False;

  WriteLn('=======================================');
  WriteLn('Simple Mining Script');
  WriteLn('Ore Type: ', ToStr(ORE_TO_MINE));
  WriteLn('Looking for: ', Self.RockUpText);
  WriteLn('Power Mining: ', POWER_MINING);
  WriteLn('=======================================');
end;

function TSimpleMiner.IsPlayerMining(): Boolean;
begin
  // Check if we gained XP (most reliable method)
  if XPBar.EarnedXP() then
    Exit(True);

  // Fallback: check for pixel movement in player area
  Result := SRL.GetPixelShift(MainScreen.GetPlayerBox(), 300) > 50;
end;

function TSimpleMiner.ClickRock(): Boolean;
var
  rockFinder: TRSObjectFinder;
  atpa: T2DPointArray;
  tpa: TPointArray;
  rect: TRectangle;
  p: TPoint;
begin
  WriteLn('Searching for ', Self.RockUpText, ' rock on screen...');

  // Setup the finder to search for our rock color
  rockFinder.Colors += Self.RockColor;
  rockFinder.ClusterDistance := 5;
  rockFinder.Erode := 2;
  rockFinder.Grow := 3;

  // Find rocks on mainscreen
  atpa := MainScreen.FindObject(rockFinder);

  if Length(atpa) = 0 then
  begin
    WriteLn('No rocks found on screen');
    Exit(False);
  end;

  WriteLn('Found ', Length(atpa), ' potential rock(s)');

  // Sort by distance from player and try each one
  atpa.SortFrom(MainScreen.Center());

  for tpa in atpa do
  begin
    if Length(tpa) < 10 then  // Skip tiny clusters
      Continue;

    // Get a point to hover over
    rect := tpa.MinAreaRect();
    p := rect.Mean();

    // Move mouse to the rock
    Mouse.Move(p);

    // Check uptext to verify it's the right rock
    if MainScreen.IsUpText(Self.RockUpText, 250) then
    begin
      WriteLn('Found correct rock, clicking...');
      Mouse.Click(MOUSE_LEFT);

      if MainScreen.DidRedClick() then
      begin
        WriteLn('Successfully clicked rock');
        Wait(1000, 1500);
        Self.IsMining := True;
        Exit(True);
      end;
    end;
  end;

  WriteLn('Could not find/click valid rock');
  Result := False;
end;

function TSimpleMiner.GetState(): EState;
begin
  // Check if we should end
  if WL.Activity.IsFinished() then
    Exit(END_SCRIPT);

  // Check if inventory is full
  if Inventory.IsFull() then
  begin
    if POWER_MINING then
      Exit(DROP_ORES)
    else
      Exit(INVENTORY_FULL);
  end;

  // Check if we're currently mining
  if Self.IsMining then
  begin
    if Self.IsPlayerMining() then
    begin
      Exit(WAIT_MINING);
    end
    else
    begin
      WriteLn('Stopped mining - rock depleted or interrupted');
      Self.IsMining := False;
    end;
  end;

  // Need to click a rock
  Exit(CLICK_ROCK);
end;

procedure TSimpleMiner.Run(maxActions: UInt32; maxTime: UInt64);
begin
  Self.Init(maxActions, maxTime);

  repeat
    Self.State := Self.GetState();
    Self.SetAction(ToStr(Self.State));

    case Self.State of
      CLICK_ROCK:
      begin
        if not Self.ClickRock() then
        begin
          WriteLn('Rock not found or failed to click, waiting...');
          Wait(500, 1000);
        end;
      end;

      WAIT_MINING:
      begin
        Wait(500, 1000);
        // Mining in progress
      end;

      DROP_ORES:
      begin
        WriteLn('Inventory full - dropping ores...');
        Inventory.ShiftDrop(Inventory.GetUsedSlots(), DROP_PATTERN_SNAKE);
        Wait(500, 1000);
        Self.TotalActions := Self.TotalActions + 1;
      end;

      INVENTORY_FULL:
      begin
        WriteLn('Inventory is full! Stopping script.');
        WriteLn('Total actions: ', Self.TotalActions);
        Break;
      end;

      END_SCRIPT:
      begin
        WriteLn('Script finished!');
        Break;
      end;
    end;

    Self.DoAntiban();
  until Self.ShouldStop();
end;

var
  SimpleMiner: TSimpleMiner;

begin
  SimpleMiner.Run(WLSettings.MaxActions, WLSettings.MaxTime);
end.
