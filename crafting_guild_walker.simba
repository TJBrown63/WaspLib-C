{$DEFINE SCRIPT_ID := 'simple-walker'}
{$DEFINE SCRIPT_REVISION := '1'}
{$I SRL-T/osr.simba}
{$I WaspLib/osr.simba}

(*
 * Simple Two-Point Walker
 *
 * Configure your coordinates below and the script will walk back and forth.
 * To find coordinates, use the built-in WaspLib position finder or check the
 * waspweb.graph file for known locations.
 *)

const
  // ===== CONFIGURE YOUR COORDINATES HERE =====
  // Using WaspWeb graph nodes for reliable pathing
  LOCATION_A: TPoint = [7128, 3289];  // Crafting Guild (graph node)
  LOCATION_B: TPoint = [7177, 2976];  // Falador West Bank (graph node)

  WALK_RADIUS: Int32 = 12;            // How close to get before considering "arrived"
  WAIT_TIME: Int32 = 10000;           // How long to wait at each location (milliseconds)

  // Region to load - make sure it covers both your locations!
  // Expanded from RSRegions.FALADOR to include more space around Crafting Guild
  WALKER_REGION: TBox = [6990, 2796, 7750, 3500];  // Extended FALADOR region
  // ============================================

type
  EState = (
    WALK_TO_A,
    AT_A,
    WALK_TO_B,
    AT_B,
    END_SCRIPT
  );

  TSimpleWalker = record(TBaseWalkerScript)
    State: EState;
  end;

procedure TSimpleWalker.Init(maxActions: UInt32; maxTime: UInt64); override;
begin
  inherited;

  // Setup the walker with your configured region
  Self.RSW.SetupRegion(WALKER_REGION);

  // Use minimap walking instead of screen walking
  Self.RSW.ScreenWalk := False;

  // Disable adaptive walk to prevent weird pathing
  Self.RSW.AdaptiveWalk := False;

  WriteLn('=======================================');
  WriteLn('Simple Two-Point Walker');
  WriteLn('Location A: ', LOCATION_A.ToString());
  WriteLn('Location B: ', LOCATION_B.ToString());
  WriteLn('Walk Radius: ', WALK_RADIUS, ' pixels');
  WriteLn('Using: Minimap walking');
  WriteLn('=======================================');
end;

function TSimpleWalker.GetState(): EState;
var
  currentPos: TPoint;
  distToA, distToB: Double;
begin
  // Check if we should end the script
  if WL.Activity.IsFinished() then
    Exit(END_SCRIPT);

  currentPos := Self.RSW.GetMyPos();
  distToA := currentPos.DistanceTo(LOCATION_A);
  distToB := currentPos.DistanceTo(LOCATION_B);

  WriteLn('[DEBUG] Current pos: ', currentPos.ToString(), ' | Dist to A: ', Round(distToA), ' | Dist to B: ', Round(distToB));

  // Use AtTile for more reliable position checking
  if Self.RSW.AtTile(LOCATION_B, WALK_RADIUS) then
  begin
    WriteLn('Arrived at Location B: ', LOCATION_B.ToString());
    Exit(AT_B);
  end;

  if Self.RSW.AtTile(LOCATION_A, WALK_RADIUS) then
  begin
    WriteLn('Arrived at Location A: ', LOCATION_A.ToString());
    Exit(AT_A);
  end;

  // Determine where to walk based on current position
  // Walk to whichever location is farther away
  if distToB < distToA then
    Exit(WALK_TO_A)
  else
    Exit(WALK_TO_B);
end;

procedure TSimpleWalker.Run(maxActions: UInt32; maxTime: UInt64);
begin
  Self.Init(maxActions, maxTime);

  repeat
    Self.State := Self.GetState();
    Self.SetAction(ToStr(Self.State));

    case Self.State of
      WALK_TO_A:
      begin
        WriteLn('Walking to Location A: ', LOCATION_A.ToString());
        Self.RSW.WebWalk(LOCATION_A, WALK_RADIUS);
        Self.TotalActions := Self.TotalActions + 1;
      end;

      AT_A:
      begin
        WriteLn('At Location A. Waiting ', WAIT_TIME, 'ms...');
        Wait(WAIT_TIME);
        // After waiting, force walk to B
        Self.State := WALK_TO_B;
        Continue;
      end;

      WALK_TO_B:
      begin
        WriteLn('Walking to Location B: ', LOCATION_B.ToString());
        Self.RSW.WebWalk(LOCATION_B, WALK_RADIUS);
        Self.TotalActions := Self.TotalActions + 1;
      end;

      AT_B:
      begin
        WriteLn('At Location B. Waiting ', WAIT_TIME, 'ms...');
        Wait(WAIT_TIME);
        // After waiting, force walk to A
        Self.State := WALK_TO_A;
        Continue;
      end;

      END_SCRIPT:
      begin
        WriteLn('Script finished!');
        Break;
      end;
    end;

    Self.DoAntiban();
  until Self.ShouldStop();
end;

var
  SimpleWalker: TSimpleWalker;

begin
  SimpleWalker.Run(WLSettings.MaxActions, WLSettings.MaxTime);
end.
